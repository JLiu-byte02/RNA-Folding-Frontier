*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Data and checkpoints (live on the compute server).
# Root-anchored: "data/" also matched src/rff/data/, which silently ignored new
# source modules placed there.
/data/
/checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.hdf5
*.npz
*.pkl
*.fa
*.fasta
*.fa.gz

# Logs and transient outputs
experiments/**/logs/
experiments/**/runs/
/logs/
/runs/
/tools/
/state/ssh_status.json
# Per-sequence dumps are multi-MB and fully regenerable from the committed
# script + seed + pinned input hash; the metadata file records which.
experiments/**/dump.jsonl
wandb/
*.log
*.out
*.err

# Local / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

